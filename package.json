{
	"name": "@zokugun/eslint-tester",
	"description": "Test ESLint configurations and rules using JSON or YAML fixtures.",
	"version": "0.1.1",
	"author": {
		"name": "Baptiste Augrain",
		"email": "daiyam@zokugun.org"
	},
	"license": "MIT",
	"homepage": "https://github.com/zokugun/node-eslint-tester",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zokugun/node-eslint-tester.git"
	},
	"bugs": {
		"url": "https://github.com/zokugun/node-eslint-tester/discussions/categories/issue-triage"
	},
	"type": "module",
	"exports": {
		".": {
			"import": "./lib/esm/index.mjs",
			"require": "./lib/cjs/index.cjs"
		}
	},
	"main": "lib/cjs/index.cjs",
	"module": "lib/esm/index.mjs",
	"typesVersions": {
		"*": {
			".": [
				"./lib/cjs/index.d.cts"
			]
		}
	},
	"scripts": {
		"audit:fix": "npm audit fix --min-release-age=0",
		"build": "npm run clean && npm run build:out",
		"build:out": "tsc-leda generate",
		"build:package": "tsc-leda update-package && npm run lint:package",
		"ci:lint": "zizmor .",
		"ci:lint:fix": "zizmor . --fix=all",
		"clean": "rimraf lib; rimraf .src; rimraf .test",
		"compile:src": "tsc -p src",
		"compile:test": "tsc -p test",
		"lint": "eslint",
		"lint:all": "npm run lint:package && npm run lint && npm audit && npm run ci:lint",
		"lint:fix": "eslint --fix",
		"lint:package": "fixpack || true",
		"prepack": "npm run build",
		"prepare": "husky; npm run lint:package",
		"release": "release-it",
		"test": "vitest run --reporter tree",
		"test:coverage": "vitest run --reporter tree --coverage --coverage.reporter text",
		"test:ui": "vitest --ui --coverage",
		"test:watch": "vitest",
		"update:artifacts": "artifact update",
		"update:ci": "pinact run -min-age 7 -update",
		"update:deps": "taze --all",
		"watch:build": "tsc-watch -p src --onSuccess 'npm run build'",
		"watch:src": "tsc-watch -p src",
		"watch:test": "tsc-watch -p test"
	},
	"dependencies": {
		"@typescript-eslint/rule-tester": "8.68.0",
		"@typescript-eslint/utils": "8.68.0",
		"@zokugun/callsite": "0.1.1",
		"@zokugun/is-it-type": "0.8.1",
		"@zokugun/xtry": "0.12.1",
		"picomatch": "4.0.7"
	},
	"devDependencies": {
		"@commitlint/cli": "20.5.3",
		"@commitlint/config-conventional": "20.5.3",
		"@types/node": "20.19.43",
		"@types/picomatch": "4.0.3",
		"@vitest/coverage-v8": "4.1.11",
		"@vitest/ui": "4.1.11",
		"@zokugun/eslint-config": "0.2.1",
		"@zokugun/eslint-config-data": "0.2.1",
		"@zokugun/eslint-config-glossary": "0.2.0",
		"@zokugun/eslint-config-js": "0.2.1",
		"@zokugun/eslint-config-md": "0.4.1",
		"@zokugun/eslint-config-nodejs": "0.2.0",
		"@zokugun/eslint-config-style": "0.3.1",
		"@zokugun/eslint-config-test": "0.2.0",
		"@zokugun/eslint-config-ts": "0.3.2",
		"@zokugun/fs-extra-plus": "0.6.2",
		"@zokugun/tsc-leda": "0.9.0",
		"eslint": "10.9.0",
		"fixpack": "4.0.0",
		"husky": "9.1.7",
		"lint-staged": "16.4.0",
		"release-it": "20.2.1",
		"rimraf": "6.1.3",
		"taze": "19.17.2",
		"tsc-watch": "7.2.1",
		"typescript": "5.9.3",
		"vitest": "4.1.11",
		"yaml": "2.9.0"
	},
	"peerDependencies": {
		"eslint": ">=10.0.0",
		"vitest": ">=4.0.0"
	},
	"overrides": {
		"@octokit/request": {
			"content-type": "2.1.0"
		},
		"vite": {
			"nanoid": "3.3.18"
		},
		"release-it": {
			"undici": "7.29.0"
		}
	},
	"allowScripts": {
		"unrs-resolver": true,
		"@zokugun/cli-utils": true,
		"fsevents": true
	},
	"keywords": [
		"eslint",
		"fixtures",
		"testing"
	]
}
